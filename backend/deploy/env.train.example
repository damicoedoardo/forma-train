# Copy to .env.train on the server (never commit it) and fill in.

# The `train` database and user in the game's Postgres (see setup-db.sql).
TRAIN_DATABASE_URL=postgresql://train:CHANGE_ME@postgres:5432/train

# Supabase: Project settings, API. The issuer is <project url>/auth/v1.
TRAIN_SUPABASE_ISSUER=https://<ref>.supabase.co/auth/v1
TRAIN_SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# A custom app domain, if any (the Vercel addresses are allowed already).
TRAIN_CORS_ORIGINS=http://localhost:3000

# The game's LiteLLM proxy. Make a key for Forma Train with its master key, and add the
# `train-coach` model to its config (litellm-train.yaml).
TRAIN_LITELLM_URL=http://litellm:4000
TRAIN_LITELLM_KEY=
TRAIN_COACH_MODEL=train-coach
